# BolKarigar Production — copy to .env and fill values
PORT=5002
NODE_ENV=production

# Local testing: ₹199/₹699 switch bar (localhost par auto; production par true set karein)
DEV_PLAN_TOGGLE=false

# Required
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/bolkarigar
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars

# Optional — AI (Google AI Studio: AIzaSy... ya AQ.... keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Voice parse + Live chat: auto (OpenAI GPT-4o first) | openai | gemini
VOICE_AI_PROVIDER=auto
CHAT_AI_PROVIDER=auto

# Optional — email password reset (SMTP ya Resend — koi ek chahiye live forgot-password ke liye)
# Gmail App Password (16 chars) — Google Account > Security > 2-Step Verification > App passwords
# SMTP_PASS me spaces hata kar paste karein (e.g. abcdabcdabcdabcd)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=BolKarigar
SMTP_SECURE=false

# Resend.com (HTTPS — works on Render FREE)
RESEND_API_KEY=
RESEND_FROM=BolKarigar <onboarding@resend.dev>

# Brevo.com (HTTPS — RECOMMENDED for Render FREE, 300 emails/day free)
# Sign up → verify sender email → API key from: SMTP & API → API keys (starts with xkeysib-)
# NOT the SMTP key (xsmtpsib-) — that will NOT work with this app
BREVO_API_KEY=
BREVO_FROM_EMAIL=vkverma3185@gmail.com

# Production CORS (comma-separated origins)
ALLOWED_ORIGINS=https://app.yourdomain.com

# GSP — MasterGST / WhiteBooks sandbox (after approval)
GSP_PROVIDER=mastergst
GSP_BASE_URL=https://api.mastergst.com
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_EMAIL=

# Optional — SMS OTP (MSG91 / Twilio — keys milne par activate)
MSG91_API_KEY=
MSG91_SENDER_ID=BOLKAR

# Optional — Razorpay subscription (payment gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Tally local (optional)
TALLY_XML_URL=http://localhost:9000

# Optional — automated daily backup email jaayega isi address pe.
# Khali chhodoge to SMTP_USER wale email pe chala jayega by default.
BACKUP_EMAIL_TO=
